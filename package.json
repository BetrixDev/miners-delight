{
  "name": "miners-delight",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@orpc/server": "^1.12.2",
      "@orpc/client": "^1.12.2",
      "@orpc/openapi": "^1.12.2",
      "@orpc/zod": "^1.12.2"
    }
  },
  "type": "module",
  "scripts": {
    "check": "oxlint && oxfmt --write",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @miners-delight/db db:push",
    "db:studio": "turbo -F @miners-delight/db db:studio",
    "db:generate": "turbo -F @miners-delight/db db:generate",
    "db:migrate": "turbo -F @miners-delight/db db:migrate"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "turbo": "^2.6.3",
    "oxlint": "^1.34.0",
    "oxfmt": "^0.19.0",
    "typescript": "catalog:",
    "@types/node": "^22.13.11"
  },
  "packageManager": "bun@1.3.4"
}
